# 依赖与构建产物（npm run build 生成，不入库）
node_modules/
dist/
lib/

# 本地打包产物，发布用；源码才是唯一来源
*.tgz
*.tgz.sha256

# 环境变量与凭据
.env
.env.*
.npmrc
*.pem
*.key
*.p12
*.pfx

# 日志
*.log

# 系统垃圾（本机 Windows；.DS_Store 来自早期的 macOS 副本）
.DS_Store
Thumbs.db
desktop.ini

# 验收证据：截图矩阵与 DOM dump 体积大、可重跑生成，只在本地保留
docs/ui/verification/

# 临时工作区：内容已于 2026-11-07 清理，重新出现时仍不入库
.screenshots/
.trash/
.trae-html-share-packages/

# 代理工作树（.agents/worktrees/ 内另有 * 的自忽略规则）
# 只忽略 worktrees：.agents/notes/ 是随仓库提交的开发日志
.agents/worktrees/
