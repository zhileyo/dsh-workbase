{
  "schemaVersion": 1,
  "observedOn": "2026-11-10",
  "material": "sanitized-historical-method-example",
  "currentStatus": "not-a-current-inventory-or-backup-guarantee",
  "consistency": "method-only-not-a-snapshot",
  "records": [
    {
      "id": "sessions",
      "path": "~/.dsh/sessions",
      "policy": "required",
      "restoreRule": "all-generations-and-relations-no-live-lock-identity"
    },
    {
      "id": "workspace",
      "path": "~/.dsh/storages/workspace.json",
      "policy": "required"
    },
    {
      "id": "workbase",
      "path": "~/.dsh/storages/dsh_workbase.json",
      "policy": "required"
    },
    {
      "id": "workbench-legacy",
      "path": "~/.dsh/storages/dsh_workbench.json",
      "policy": "migration-rollback-material"
    },
    {
      "id": "archive-favorites",
      "path": "~/.dsh/storages/archive_manager_favorites.json",
      "policy": "required"
    },
    {
      "id": "archive-settings",
      "path": "~/.dsh/archive-manager/settings.json",
      "policy": "required-if-present"
    },
    {
      "id": "projection-cache",
      "path": "~/.dsh/storages/session_projcache",
      "legacyPath": "~/.dsh/storages/session_projcache.json",
      "policy": "retain-until-rebuild-verified"
    },
    {
      "id": "context-overview",
      "path": "~/.dsh/storages/dsh-context/overview-cache.v1.json",
      "policy": "rebuild-candidate"
    },
    {
      "id": "image-objects",
      "path": "~/.dsh/attachments/v1/objects",
      "policy": "required-if-present",
      "override": "attachment-local.config.dshHome"
    },
    {
      "id": "file-objects",
      "path": "~/.dsh/attachments/v1/file-objects",
      "policy": "required-if-present"
    },
    {
      "id": "file-reference-links",
      "path": "~/.dsh/attachments/v1/files",
      "policy": "required-if-present",
      "restoreRule": "validated-hardlinks-or-equivalent-name-paths"
    },
    {
      "id": "attachment-request-cache",
      "path": "~/.dsh/cache/attachments/request-images",
      "policy": "documented-rebuildable"
    },
    {
      "id": "profiles",
      "path": "~/.dsh/profiles/{desktop,web,tui}",
      "policy": "required-config-lockfile-and-plugin-payload"
    },
    {
      "id": "market-profile-state",
      "path": "~/.dsh/profiles/{desktop,web}/.dsh-market",
      "policy": "mixed-state-and-cache-needs-file-classification"
    },
    {
      "id": "market-build-markers",
      "path": "~/.dsh/dsh-market/printed-build-keys.json",
      "policy": "noncritical-marker"
    },
    {
      "id": "agent-presets",
      "path": "~/.dsh/.agent-presets",
      "policy": "required"
    },
    {
      "id": "credentials",
      "path": "~/.dsh/.credentials.yaml",
      "policy": "optional-encrypted",
      "contentsRead": false
    },
    {
      "id": "legacy-settings",
      "path": "~/.dsh/settings.yaml.imported",
      "policy": "sensitive-migration-material",
      "contentsRead": false
    },
    {
      "id": "remote-devices",
      "path": "~/.dsh/remote-web-ui-devices.json",
      "policy": "identity-material-explicit-restore-policy",
      "contentsRead": false
    },
    {
      "id": "skills-manager",
      "path": "~/.dsh/skills-manager",
      "policy": "required-if-present",
      "persistentChildren": [
        "state.json",
        "roots.json",
        "repositories.json",
        "trash"
      ]
    },
    {
      "id": "dsh-user-skills",
      "path": "~/.dsh/skills",
      "policy": "required-if-present"
    },
    {
      "id": "shared-agent-skills",
      "path": "~/.agents/skills",
      "policy": "external-shared-root-explicit-scope"
    },
    {
      "id": "project-skills",
      "path": "<registered-project>/.dsh/skills",
      "policy": "explicit-external-dependency-if-present"
    },
    {
      "id": "bili-config",
      "path": "~/.config/billion-context",
      "policy": "required-sensitive-config",
      "overrides": [
        "XDG_CONFIG_HOME",
        "BILI_CONFIG_FILE"
      ]
    },
    {
      "id": "bili-data",
      "path": "~/.local/share/billion-context",
      "policy": "mixed-persistent-and-secret-data",
      "overrides": [
        "XDG_DATA_HOME",
        "BILI_SESSIONS_DIR"
      ]
    },
    {
      "id": "bili-sessions",
      "path": "~/.local/share/billion-context/sessions",
      "policy": "required-shared-dataset",
      "restoreRule": "stop-all-writers-preserve-committed-sqlite-state-and-history"
    },
    {
      "id": "bili-ca",
      "path": "~/.local/share/billion-context/ca",
      "policy": "optional-encrypted",
      "contentsRead": false
    },
    {
      "id": "bili-state",
      "path": "~/.local/state/billion-context",
      "policy": "mixed-mapping-log-and-live-lease-classification-required",
      "override": "XDG_STATE_HOME"
    },
    {
      "id": "bili-cache",
      "path": "~/.cache/billion-context",
      "policy": "mixed-download-and-update-state-not-blanket-excluded",
      "override": "XDG_CACHE_HOME"
    },
    {
      "id": "tui-state",
      "path": "~/.dsh-tui",
      "policy": "persistent-external-root",
      "restoreRule": "no-effect-ledger-replay"
    },
    {
      "id": "pet-config-assets",
      "path": "~/.dsh/dsh-pet",
      "policy": "required-config-and-user-assets-exclude-confirmed-log"
    },
    {
      "id": "pet-legacy",
      "path": "~/.dsh/pet.json",
      "policy": "unclassified-migration-material"
    },
    {
      "id": "desktop-client",
      "path": "~/Library/Application Support/@deepseek-ai/dsh-desktop",
      "policy": "structured-export-preferred-no-whole-profile-copy",
      "valuesRead": false
    },
    {
      "id": "pet-client",
      "path": "~/Library/Application Support/dsh-pet-electron-helper",
      "policy": "client-state-adapter-required",
      "valuesRead": false
    },
    {
      "id": "task-board",
      "path": "~/.dsh/task-board",
      "policy": "unclassified-persistent-owner-not-confirmed",
      "persistentChildren": [
        "ledger-v2.json",
        "scheduler-v2.json"
      ]
    },
    {
      "id": "skin-state",
      "path": "~/.dsh/skin-center-active.json",
      "policy": "unclassified-persistent-owner-not-confirmed"
    },
    {
      "id": "skin-resources",
      "path": "~/.dsh/skin-center",
      "policy": "retain-until-regeneration-and-owner-confirmed"
    },
    {
      "id": "voice-models",
      "path": "~/.dsh/speech-to-text/sensevoice",
      "policy": "rebuildable-model-candidate"
    },
    {
      "id": "recycle-bin-legacy",
      "path": "~/.dsh/trash",
      "policy": "required-if-present-version-adapter-needed"
    }
  ],
  "exclusions": {
    "projectSource": "not-in-first-release",
    "otherAgentReadOnlySkillRoots": "not-implicitly-included",
    "externalSymlinkTargets": "not-followed-during-inventory",
    "sessionBodies": "not-read-during-inventory",
    "credentialsAndPrivateKeys": "contents-not-read",
    "browserValues": "not-read"
  },
  "note": "仅保留2026-11-10盘点方法与路径模板；已去除个人profile、插件版本、会话和文件计数、大小及私钥存在情况。当前备份能力与边界见开发日志。"
}
